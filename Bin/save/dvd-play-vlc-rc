#else
#    stream_info "$DVD_PATH_ENCODED#$DVD_TITLE:$DVD_CHAPTER-$DVD_TITLE:$DVD_CHAPTER"
#    log "Playing DVD title: $DVD_TITLE, chapter: $DVD_CHAPTER with auto-selected audio stream : $ES"
#fi

# ------------------------------
# VLC start/stop options
# ------------------------------
VLC_TIME_OPTS=""
[ "$START_POS" -ne 0 ] && VLC_TIME_OPTS+=" --start-time=$START_POS"
[ "$END_POS" -ne 0 ] && VLC_TIME_OPTS+=" --stop-time=$END_POS"

# ------------------------------
# Log script info
# ------------------------------
log "Audio converted to format: $AUDIO_FORMAT"
log "=================================="

# ------------------------------
# Build VLC --sout
# ------------------------------
#if [[ -n "$ES" ]]; then
#   VLC_SOUT="#duplicate{dst={transcode{acodec=$AUDIO_FORMAT,channels=2,samplerate=48000}:standard{mux=wav,dst=-,access=file}},select=\"$ES\"}"
#else
#   VLC_SOUT="#duplicate{dst={transcode{acodec=$AUDIO_FORMAT,channels=2,samplerate=48000}:standard{mux=wav,dst=-,access=file}}}"
#fi

if [ ! -p  "/config/prefs/PlayDVD/vlc-${PLAYER_MAC}.sock" ]; then
    mkfifo "/config/prefs/PlayDVD/vlc-${PLAYER_MAC}.sock"
fi
VLC_SOUT="'"$VLC_SOUT"'"
VLC_CMD="cvlc -I oldrc --rc-fake-tty --rc-unix /config/prefs/PlayDVD/vlc-${PLAYER_MAC}.sock --no-lua \
--log-verbose=3 --file-logging --logfile=/config/prefs/PlayDVD/log/vlc-report-$PLAYER_MAC.log \
dvdnav://$DVD_PATH_ENCODED#$DVD_TITLE:$DVD_CHAPTER $VLC_TIME_OPTS --no-sout-video \
--sout '#transcode{acodec=$AUDIO_FORMAT,channels=2,samplerate=48000}:std{access=file,mux=wav,dst=-}' \
--rate=1 \
